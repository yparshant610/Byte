# =============================================================================
# Food Bytes Ecosystem — Root Environment Configuration Template
# Copy this file to .env in the root or corresponding apps for local development
# =============================================================================

# --- APPLICATION ENVIRONMENT ---
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# --- POSTGRESQL / SUPABASE DATABASE ---
# Default credentials align with docker/docker-compose.yml
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/foodbytes_db?schema=public
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- REDIS IN-MEMORY & GEOSPATIAL ENGINE ---
# Used for: shopping cart (cart:{userId}), restaurant geo index (restaurants:geo),
# and delivery partner tracking (drivers:available:geo)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Set to 'true' to use the zero-dependency in-memory mock engine without running Redis locally
REDIS_USE_MOCK=false

# --- AUTHENTICATION & JWT ---
JWT_SECRET=super_secret_foodbytes_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# --- NODEMAILER / TRANSACTIONAL EMAIL (OTP VERIFICATION) ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="Food Bytes <no-reply@foodbytes.app>"

# --- RAZORPAY MULTI-SPLIT PAYMENTS (80% RESTAURANT+DRIVER / 20% ADMIN) ---
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_for_signature_verification

# --- AWS S3 (VENDOR COVERS, DISH IMAGES, KYC, PROOF OF DELIVERY) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=foodbytes-media-assets

# --- GOOGLE MAPS SDK (GEOLOCATION & ROUTING) ---
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
