# =============================================================================
# Food Byte — User Backend Service (.env.example)
# Copy to apps/user-service/.env for local service execution
# =============================================================================

# Server Port & Mode
PORT=4000
NODE_ENV=development

# =============================================================================
# SUPABASE DATABASE CONFIGURATION
# =============================================================================
# Direct or Pooler Connection URI (Supabase Dashboard -> Settings -> Database)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Supabase API Credentials (Supabase Dashboard -> Settings -> API)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_public_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key"

# Redis Engine (Cart, Geospatial Discovery under 10km, Driver Dispatch)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Set REDIS_USE_MOCK=true to run with built-in in-memory fallback without a Redis server
REDIS_USE_MOCK=false

# Authentication
JWT_SECRET=super_secret_foodbytes_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# =============================================================================
# OPTION 2: GMAIL SMTP CONFIGURATION
# =============================================================================
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address and 16-character App Password below:
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="Food Bytes <your_email@gmail.com>"

# Razorpay Webhook Secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_test
