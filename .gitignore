# =============================================================================
# Food Bytes Monorepo .gitignore
# =============================================================================

# Dependencies
node_modules/
.pnpm-store/

# Environment Variables & Secrets (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Build Artifacts & Caches
dist/
build/
.turbo/
*.tsbuildinfo

# Logs & Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary Docker volume data mounts
postgres_data/
redis_data/

# Generated scratch / coverage
coverage/
.nyc_output/
.system_generated/
